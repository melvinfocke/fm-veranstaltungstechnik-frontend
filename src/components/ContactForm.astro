---
import DatePicker from './DatePicker.astro';
import { apiEndpoint } from '../env';
---

<form method="post" action={`${apiEndpoint}/v1/contact-form/submit`}>
  <div class="two-horizonal-fields">
    <div>
      <label for="first_name">Vorname:</label>
      <input type="text" id="first_name" name="first_name" required />
    </div>
    <div>
      <label for="last_name">Nachname:</label>
      <input type="text" id="last_name" name="last_name" required />
    </div>
  </div>

  <label for="email">E-Mail:</label>
  <input type="email" id="email" name="email" required />

  <label for="type_of_request">Art der Anfrage:</label>
  <select id="type_of_request" name="type_of_request" required>
    <option value="">Wähle aus…</option>
    <option value="Musik / DJ">Musik / DJ</option>
    <option value="Lasershow">Lasershow</option>
    <option value="Verleih von Technik">Verleih von Technik</option>
    <option value="Anderes Anliegen">Anderes Anliegen</option></select
  >

  <div class="two-horizonal-fields">
    <div>
      <label for="location" class="optional">Ort der Veranstaltung:</label>
      <input type="text" id="location" name="location" class="optional" />
    </div>
    <div>
      <label for="date" class="optional">Datum:</label>
      <DatePicker id="date" name="date" class="optional" />
    </div>
  </div>
  <div class="two-horizonal-fields">
    <div>
      <label for="time_start" class="optional">Uhrzeit von:</label>
      <input type="time" id="time_start" name="time_start" class="optional" />
    </div>
    <div>
      <label for="time_end" class="optional">Uhrzeit bis:</label>
      <input type="time" id="time_end" name="time_end" class="optional" />
    </div>
  </div>

  <label for="message">Nachricht:</label>
  <textarea id="message" name="message" rows="5" cols="50" required></textarea>

  <div class="submit-wrapper">
    <span>Alle Felder sind erforderlich!</span>
    <input type="submit" value="Absenden" />
  </div>
</form>

<style>
  form {
    margin: 0 auto;
    height: 41.5rem;
    display: flex;
    flex-direction: column;
  }

  label {
    display: block;
    margin-block: 0.5rem;
    color: inherit;
    font-size: 0.75rem;
  }

  input[type='text'],
  input[type='email'],
  input[type='date'],
  input[type='time'],
  select,
  textarea {
    width: 12.1875rem;
    min-width: 100%;
    padding: 0.625rem;
    border: 1px solid #ccc;
    border-radius: 0.25rem;
    box-sizing: border-box;
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    background: transparent;
    color: inherit;
    height: 2.925rem;
  }

  select {
    appearance: none;
    background-color: var(--color-black);
    background-image:
      linear-gradient(45deg, transparent 50%, var(--color-white) 50%),
      linear-gradient(135deg, var(--color-white) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) calc(1em + 2px),
      calc(100% - 15px) calc(1em + 2px);
    background-size:
      5px 5px,
      5px 5px;
    background-repeat: no-repeat;
  }

  select option {
    background-color: var(--color-gray-800);
  }

  textarea {
    resize: vertical;
    font-family: inherit;
  }

  input[type='submit'] {
    background-color: #4caf50;
    color: var(--color-black);
    padding: 0.625rem 1.25rem;
    border: none;
    border-radius: 1.2rem;
    cursor: pointer;
    font-size: 1.125rem;
    background-color: var(--color-white);
  }

  input[type='submit']:hover {
    filter: brightness(0.9);
  }

  .two-horizonal-fields {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .two-horizonal-fields div {
    width: 100%;
  }

  .submit-wrapper {
    text-align: right;
  }

  .submit-wrapper span {
    margin-right: 1rem;
    display: inline-block;
    font-size: 0.875rem;
    color: red;
  }

  textarea[name='message'] {
    flex: 1 1 auto;
  }

  select[name='type_of_request']:has(> option[value='Anderes Anliegen']:checked) ~ div .optional {
    display: none;
  }
</style>

<style is:global>
  select[name='type_of_request']:has(> option[value='Anderes Anliegen']:checked) ~ div .optional {
    display: none;
  }
</style>

<script>
  const API_ENDPOINT = document.querySelector('html')?.getAttribute('data-api-endpoint') || '';

  const modifyOptionalFields = (isRequired: boolean) => {
    document.querySelectorAll('input.optional').forEach((element) => {
      (element as HTMLInputElement).required = isRequired;
    });
  };
  modifyOptionalFields(true);

  document.querySelector('select[name="type_of_request"]')?.addEventListener('change', (event) => {
    modifyOptionalFields((event.target as HTMLSelectElement).value !== 'Anderes Anliegen');
  });

  document.querySelector('.submit-wrapper span')?.remove();

  document.querySelector('form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const target = event.target as HTMLFormElement;

    const formData = new FormData(target);
    const data = Object.fromEntries(formData);

    const response = await fetch(`${API_ENDPOINT}/v1/contact-form/submit`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ ...data, timestamp: new Date().toISOString() })
    });

    if (response.ok) {
      alert('Formular wurde erfolgreich abgesendet. Wir melden uns in Kürze bei dir.');
      target.reset();
    } else if (response.status === 429) {
      alert('Du hast innerhalb kurzer Zeit zu viele Anfragen gesendet. Bitte versuche es später erneut.');
    } else {
      alert(
        'Fehler beim Absenden des Formulars. Bitte versuche es später erneut oder kontaktiere uns direkt per E-Mail oder Telefon.'
      );
    }
  });
</script>
