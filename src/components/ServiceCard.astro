---
import type { ImageMetadata } from 'astro';
import { Picture, Image } from 'astro:assets';

interface Props {
  headline: string;
  href: string | null;
  iconSource: ImageMetadata;
  iconAlt: string;
  backgroundSource: ImageMetadata;
  backgroundAlt: string;
  description: string;
}

const { headline, href, iconSource, iconAlt, backgroundSource, backgroundAlt, description } = Astro.props;
---

{
  href ? (
    <a href={href} aria-disabled={!href} class="service-card">
      <Picture src={backgroundSource} alt={backgroundAlt} widths={[480, 720, 960]} class="bg" />
      <div>
        <Image src={iconSource} alt={iconAlt} />
        <h3>{headline}</h3>
        <p set:html={description} />
      </div>
    </a>
  ) : (
    <div aria-disabled={!href} class="service-card">
      <Picture src={backgroundSource} alt={backgroundAlt} widths={[480, 720, 960]} class="bg" />
      <div>
        <Image src={iconSource} alt={iconAlt} />
        <h3>{headline}</h3>
        <p set:html={description} />
      </div>
    </div>
  )
}

<style>
  .service-card {
    width: 20rem;
    position: relative;
    border-radius: 1rem;
    outline: 1px solid var(--color-gray-700);
    color: inherit;
    transition: transform 0.1s ease-in-out;
  }

  .service-card:hover {
    transform: scale(1.05);
  }

  .service-card[aria-disabled='true'] {
    pointer-events: none;
    opacity: 0.55;
  }

  .service-card .bg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.5) contrast(1.25);
    border-radius: 1rem;
  }

  .service-card div {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: 1.5rem;
    width: calc(100% - 3rem);
  }

  .service-card div img {
    width: 5rem;
    height: 5rem;
    margin-bottom: 1rem;
    filter: invert(1);
  }

  h3 {
    font-family: inherit;
    text-transform: inherit;
    margin-block: 0.5rem 1.5rem;
    letter-spacing: inherit;
  }
</style>
